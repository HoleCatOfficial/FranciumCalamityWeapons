	GodSlayerScepter: {
		DisplayName: Fýlakatanalotítheón
		Tooltip:
			'''
			Shoots homing Cosmic Stars that accelerate towards their target.
			Throwing the scepter will make it follow your cursor if you keep holding down.
			When thrown, it will release a burst of Cosmic stars when hitting an enemy.
			'''
	}

	TarragonMane: {
		DisplayName: Tarragon Mane
		Tooltip: ""
		SetBonus:
			'''
			Thrown Scepters release stationary bombs that do not collide with npcs or tiles.
			Pressing the armor set bonus key will detonate all active bombs at once.
			NPCs in the blast radius will have their armor broken.
			'''
	}

	VitalBane: {
		Tooltip:
			'''
			Shoots a homing ray of life energy that slashes at enemies on contact.
			When thrown, the Scepter will create a Life Energy Crsytal.
			Shooting the crystal 5 times with any friendly projectile will break it, granting a massive life regeneration boost.
			'''
		DisplayName: Vital Bane
	}

	LunarVoltageScepter: {
		DisplayName: Lunar Voltage Scepter
		Tooltip:
			'''
			Shoots a bouncing arc of lunar electricity that bounces off of tiles up to 10 times and pierces infinitely.
			When thrown, it will electrify nearby enemies and will shoot lunar flares at the closest enemy.
			'''
	}

	SilvaCrown: {
		DisplayName: Silva Crown
		Tooltip: 10% increased Scepter Critical Strike Chance
		SetBonus:
			'''
			Summons a Silva Attendant.
			The attendant will shoot out three Silva Hearts to defend you when the armor set bonus key is pressed.
			'''
	}

