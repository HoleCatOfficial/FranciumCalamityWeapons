	NecrokidHead: {
		DisplayName: Necrokid Head
		Tooltip: 24% increased Critical Strike Chance.
		SetBonus:
			'''
			You gain a charge bar that you fill whenever dealing Scepter Class Damage.
			When the bar is full, you can enter a Necroplasmic Fenzy, spawning homing necroplasmic trails as you move and getting a 20% decrease to Scepter use speed.

			'''
	}

	NecrokidPlates: {
		DisplayName: Necrokid Plates
		Tooltip: ""
	}

	Breaker: {
		DisplayName: P-TSL Breaker
		Tooltip:
			'''
			After six true melee hits, the blade accrues a powerful charge.
			The first charged hit deals double damage, but each hit after that deals diminishing damage returns, capped at 60% reduced damage.
			Charged hits inflict Static Discharge for 5 seconds.
			'''
		SchematicKnowledgeTooltip1:
			'''
			Constructed solely as a test of the capabilities of Wulfrum when combined with higher technology.
			Ultimately, it lacked a significant use case compared to other, more robust weaponry such as the [i:CalamityMod/Auger] P-GSS Auger.
			That said, it does have a singular strength: it is very cheap to produce.
			As such, the blueprints for it have sat untouched ever since the initial testing, and likely will continue to remain so.
			'''
	}

	NightGazer: {
		DisplayName: Night Gazer
		Tooltip:
			'''
			An automaton of otherworldly properties.
			Shoots three shots at a time that weakly home in on enemies and inflict Galvanic Corrosion.
			Each Gazer consumes 2 minion slots.
			'''
	}

	Proxima: {
		DisplayName: Proxima
